{
  "name": "thoadd",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "db:generate": "pnpm --filter @thoadd/db generate",
    "db:migrate": "pnpm --filter @thoadd/db migrate"
  },
  "devDependencies": {
    "turbo": "^2.11.10"
  }
}
